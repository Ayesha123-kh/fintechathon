# Every setting for the whole stack lives in this one file. backend/.env is a symlink to it (the backend and worker
# read it whole). ai-ml/.env is a small tracked file that pulls from this one only the variables the agents container
# needs, so its secrets stay out of that container. Copy .env.example to .env and fill in the secrets. Values may
# reference earlier ones with ${NAME}.


# Database and cache (compose creates the owner role; the app connects as the RLS-restricted APP_DB_ROLE)
POSTGRES_USER=fintech_owner
POSTGRES_PASSWORD=owner_password
POSTGRES_DB=fintech
APP_DB_ROLE=app_user
APP_DB_PASSWORD=app_password
DATABASE_URL=postgresql+asyncpg://${APP_DB_ROLE}:${APP_DB_PASSWORD}@postgres:5432/${POSTGRES_DB}
MIGRATION_DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
REDIS_URL=redis://dragonfly:6379/0

# Service addresses inside the compose network
BACKEND_URL=http://backend:8000
BACKEND_INTERNAL_URL=http://backend:8000
OMB_GATEWAY_URL=http://omb:8790

# App
APP_NAME=Saving
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3000/api
CORS_ORIGINS=["http://localhost:3000"]

# Auth
# JWT_SECRET: python -c "import secrets;print(secrets.token_urlsafe(48))"
# ENCRYPTION_KEY (encrypts Gmail tokens): python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
IDLE_LOCK_MINUTES=5
COOKIE_SECURE=false
ENCRYPTION_KEY=
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Saving

# Admin: ADMIN_EMAIL is the app admin. OMB_SIGNIN_EMAILS is who may sign in to the OpenMausBot web UI (same admin).
# DEMO_USER_EMAIL is the login of the demo user created by the temporary demo-data migration.
ADMIN_EMAIL=paisave.app@gmail.com
OMB_SIGNIN_EMAILS=${ADMIN_EMAIL}
ADMIN_PASSWORD=change-me-admin
DEMO_USER_EMAIL=paisave.demo@gmail.com

# Secrets the backend and the agents gateway share: python -c "import secrets;print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=change-me-internal
MCP_USER_TOKEN=change-me-mcp-user
MCP_MARKET_TOKEN=change-me-mcp-market

# Email (Gmail SMTP, use an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Web Push (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:paisave.app@gmail.com

# Gmail read-only OAuth (Google Cloud console -> OAuth client, Web application).
# Authorized redirect URI: ${PUBLIC_API_URL}/email/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_POLL_MINUTES=5

# Self-hosted models (vLLM, OpenAI compatible). They see user data: chats, advisors, bank-email parsing.
# LLM_SUPPORTS_VISION: true if the model accepts images (lets researchers and deal crawlers use OMB's browser).
LLM_BASE_URL=http://host.docker.internal:8001/v1
LLM_API_KEY=EMPTY
LLM_MODEL=qwen3.5-9b
LLM_SUPPORTS_VISION=true
STT_BASE_URL=http://host.docker.internal:8002/v1
STT_API_KEY=EMPTY
STT_MODEL=Qwen3-ASR-0.6B

# Third-party LLM (any OpenAI-compatible API) for the shared desks: watchers, researchers, analysts and deals bots.
# They only work with public data, never user data. Leave the base URL empty to run them on the self-hosted model.
# DESK_LLM_SUPPORTS_VISION: true if that model accepts images (used instead of LLM_SUPPORTS_VISION when it is set).
DESK_LLM_BASE_URL=
DESK_LLM_API_KEY=
DESK_LLM_MODEL=
DESK_LLM_SUPPORTS_VISION=false

# Decision model (Jev-like router, OpenAI-compatible chat endpoint) that picks which advisor answers each chat
# message. It sees the message text. OpenMausBot only accepts an https:// address, or http:// to this machine
# (localhost / 127.0.0.1; not host.docker.internal). Leave empty to disable auto-routing (Finance Assistant answers).
DECIDER_BASE_URL=
DECIDER_API_KEY=
DECIDER_MODEL=
