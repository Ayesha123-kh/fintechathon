# ---------- App
APP_NAME=Bachat
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3000/api
CORS_ORIGINS=["http://localhost:3000"]

# ---------- Database
# The app connects as an RLS-restricted role (created by the first migration).
DATABASE_URL=postgresql+asyncpg://app_user:app_password@postgres:5432/fintech
APP_DB_ROLE=app_user
APP_DB_PASSWORD=app_password
# Migrations run as the schema owner.
MIGRATION_DATABASE_URL=postgresql+asyncpg://fintech_owner:owner_password@postgres:5432/fintech

# ---------- Cache (Dragonfly)
REDIS_URL=redis://dragonfly:6379/0

# ---------- Auth
# python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
IDLE_LOCK_MINUTES=5
COOKIE_SECURE=false
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Bachat
ADMIN_EMAIL=admin@bachat.pk
ADMIN_PASSWORD=change-me-admin

# ---------- Email (Gmail SMTP, use an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ---------- Web Push (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@bachat.pk

# ---------- Gmail read-only OAuth (Google Cloud console -> OAuth client, Web application)
# Authorized redirect URI: ${PUBLIC_API_URL}/email/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_POLL_MINUTES=5

# ---------- Models (vLLM, OpenAI compatible)
LLM_BASE_URL=http://host.docker.internal:8001/v1
LLM_API_KEY=EMPTY
LLM_MODEL=qwen3.5-9b
STT_BASE_URL=http://host.docker.internal:8002/v1
STT_API_KEY=EMPTY
STT_MODEL=Qwen3-ASR-0.6B

# ---------- OpenMausBot gateway (ai-ml)
OMB_GATEWAY_URL=http://omb:8790
INTERNAL_API_KEY=change-me-internal
MCP_USER_TOKEN=change-me-mcp-user
MCP_MARKET_TOKEN=change-me-mcp-market
