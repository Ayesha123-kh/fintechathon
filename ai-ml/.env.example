# ---------- Backend (MCP servers + internal API)
BACKEND_URL=http://backend:8000
INTERNAL_API_KEY=change-me-internal
MCP_USER_TOKEN=change-me-mcp-user
MCP_MARKET_TOKEN=change-me-mcp-market

# ---------- LLM used by every agent (vLLM, OpenAI compatible). Thinking-enabled Qwen3.5-9B.
LLM_BASE_URL=http://host.docker.internal:8001/v1
LLM_API_KEY=EMPTY
LLM_MODEL=qwen3.5-9b
# true if the model accepts images (enables the built-in browser for researchers/deal crawlers)
LLM_SUPPORTS_VISION=true

# ---------- Decision model (Jev-like router, OpenAI-compatible chat endpoint).
# OpenMausBot only accepts https:// or http:// on this machine. Leave empty to disable auto-routing.
DECIDER_BASE_URL=
DECIDER_API_KEY=
DECIDER_MODEL=

# ---------- OpenMausBot
# Admin/member emails allowed to sign in to the OMB web UI with an emailed code (optional, for debugging).
OMB_SIGNIN_EMAILS=
