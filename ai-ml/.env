# The only variables the agents container (OpenMausBot + gateway) is given. It runs bots and a browser, so it does
# not get the whole root .env (no JWT / encryption / SMTP / OAuth / database-owner secrets).
# Every value comes from the root .env through ${NAME}: set things there, never here.
BACKEND_URL=${BACKEND_URL}
INTERNAL_API_KEY=${INTERNAL_API_KEY}
MCP_USER_TOKEN=${MCP_USER_TOKEN}
MCP_MARKET_TOKEN=${MCP_MARKET_TOKEN}
OMB_SIGNIN_EMAILS=${OMB_SIGNIN_EMAILS}

# Self-hosted model: per-user teams (and the shared desks too unless DESK_LLM_* is set)
LLM_BASE_URL=${LLM_BASE_URL}
LLM_API_KEY=${LLM_API_KEY}
LLM_MODEL=${LLM_MODEL}
LLM_SUPPORTS_VISION=${LLM_SUPPORTS_VISION}

# Shared desks (public data only): optional third-party OpenAI-compatible LLM
DESK_LLM_BASE_URL=${DESK_LLM_BASE_URL}
DESK_LLM_API_KEY=${DESK_LLM_API_KEY}
DESK_LLM_MODEL=${DESK_LLM_MODEL}
DESK_LLM_SUPPORTS_VISION=${DESK_LLM_SUPPORTS_VISION}

# Decision model that routes chat messages to advisors; empty = off
DECIDER_BASE_URL=${DECIDER_BASE_URL}
DECIDER_API_KEY=${DECIDER_API_KEY}
DECIDER_MODEL=${DECIDER_MODEL}
